<UserControl x:Class="SpreadsheetSampleExplorer.Samples.PortfolioDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sheets="http://schemas.devbrewlabs.com/2026/wpf/spreadsheet"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Margin="0">
        <!-- Main Spread Control with Enterprise Light Look -->
        <Border BorderThickness="0" Background="#F9FAFB">
            <sheets:Spread x:Name="spread"/>
        </Border>
    </Grid>
</UserControl>
