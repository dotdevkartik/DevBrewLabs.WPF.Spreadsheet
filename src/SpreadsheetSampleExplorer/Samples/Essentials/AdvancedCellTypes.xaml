<UserControl x:Class="SpreadsheetSampleExplorer.Samples.AdvancedCellTypes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sheets="http://schemas.devbrewlabs.com/2026/wpf/spreadsheet"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="950">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Control and Feature Bar -->
        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1" Padding="10,8" Margin="0,0,0,6">
            <DockPanel LastChildFill="False">
                <!-- Left: Feature Badges -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="📊 Standard Progress Bar" Foreground="#1D4ED8" FontSize="11" FontWeight="Medium"/>
                    </Border>
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="🚦 Auto-Color KPI Threshold" Foreground="#047857" FontSize="11" FontWeight="Medium"/>
                    </Border>
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="🔗 Hyperlink (Hover &amp; Hand Cursor)" Foreground="#1D4ED8" FontSize="11" FontWeight="Medium"/>
                    </Border>
                </StackPanel>

                <!-- Right: Interactive Status Notification -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F4F4F5" BorderBrush="#D4D4D8" BorderThickness="1" CornerRadius="4" Padding="8,3">
                        <TextBlock x:Name="statusTextBlock" Text="Ready (Hover over or click hyperlinks, and observe dynamic progress bars)" FontSize="11" FontWeight="SemiBold" Foreground="#18181B"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Spreadsheet Container -->
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#E4E4E7">
            <sheets:Spread x:Name="spread"/>
        </Border>
    </Grid>
</UserControl>
