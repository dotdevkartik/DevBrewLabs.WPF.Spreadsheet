<UserControl x:Class="SpreadsheetSampleExplorer.Samples.CustomCellTypes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sheets="http://schemas.devbrewlabs.com/2026/wpf/spreadsheet"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="1050">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Feature & Notification Bar -->
        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1" Padding="10,8" Margin="0,0,0,6">
            <DockPanel LastChildFill="False">
                <!-- Left: Feature Badges -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="🔘 Multi-Option Radio Groups" Foreground="#1D4ED8" FontSize="11" FontWeight="Medium"/>
                    </Border>
                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="⭐ Star Ratings (5★, 10★)" Foreground="#B45309" FontSize="11" FontWeight="Medium"/>
                    </Border>
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="🎯 In-Cell Sub-Element Hit-Testing" Foreground="#047857" FontSize="11" FontWeight="Medium"/>
                    </Border>
                    <Border Background="#F3E8FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="✨ Hover Previews &amp; Event Dispatch" Foreground="#6D28D9" FontSize="11" FontWeight="Medium"/>
                    </Border>
                </StackPanel>

                <!-- Right: Interactive Status Notification -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F4F4F5" BorderBrush="#D4D4D8" BorderThickness="1" CornerRadius="4" Padding="8,3">
                        <TextBlock x:Name="statusTextBlock" Text="Ready (Click any radio button or star to test custom in-cell interactions!)" FontSize="11" FontWeight="SemiBold" Foreground="#18181B"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Spreadsheet Container -->
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#E4E4E7">
            <sheets:Spread x:Name="spread"/>
        </Border>
    </Grid>
</UserControl>
