<UserControl x:Class="SpreadsheetSampleExplorer.Samples.Sorting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpreadsheetSampleExplorer.Samples" 
             xmlns:sheets="http://schemas.devbrewlabs.com/2026/wpf/spreadsheet"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Control Bar -->
        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1"  Padding="10,6" Margin="0,0,0,6">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Data Mode:" VerticalAlignment="Center" FontSize="11.5" FontWeight="Medium" Foreground="#3F3F46" Margin="0,0,6,0"/>
                    <ComboBox x:Name="modeComboBox" Width="180" Margin="0,0,12,0" SelectedIndex="0" SelectionChanged="OnModeSelectionChanged">
                        <ComboBoxItem Content="Unbound 2D Grid"/>
                        <ComboBoxItem Content="Bound (List&lt;Customer&gt;)"/>
                        <ComboBoxItem Content="Hybrid (Bound + Notes/Check)"/>
                    </ComboBox>

                    <TextBlock Text="Sorting:" VerticalAlignment="Center" FontSize="11.5" FontWeight="Medium" Foreground="#3F3F46" Margin="0,0,8,0"/>
                    <Button Content="Sort Ascending ▲" Style="{StaticResource ModernButton}" Click="OnSortAscending" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                    <Button Content="Sort Descending ▼" Style="{StaticResource ModernOutlineButton}" Click="OnSortDescending" Padding="10,4" FontSize="11" Margin="0,0,10,0"/>
                    
                    <TextBlock Text="Advanced:" VerticalAlignment="Center" FontSize="11.5" FontWeight="Medium" Foreground="#3F3F46" Margin="0,0,8,0"/>
                    <Button Content="Multi-Level Sort" Style="{StaticResource ModernOutlineButton}" Click="OnMultiLevelSort" Padding="10,4" FontSize="11" Margin="0,0,6,0" ToolTip="Sort by 2 levels"/>
                    <Button Content="Custom Sort" Style="{StaticResource ModernOutlineButton}" Click="OnCustomSort" Padding="10,4" FontSize="11" Margin="0,0,10,0" ToolTip="Sort active column by String Length"/>
                    <Button Content="Reset Data" Style="{StaticResource ModernOutlineButton}" Click="OnResetData" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F4F4F5" BorderBrush="#D4D4D8" BorderThickness="1" CornerRadius="3" Padding="8,3">
                        <TextBlock x:Name="statusTextBlock" Text="IsBound: False" FontSize="11" FontWeight="SemiBold" Foreground="#18181B"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Spreadsheet View -->
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#E4E4E7" >
            <sheets:Spread x:Name="spread"/>
        </Border>
    </Grid>
</UserControl>
