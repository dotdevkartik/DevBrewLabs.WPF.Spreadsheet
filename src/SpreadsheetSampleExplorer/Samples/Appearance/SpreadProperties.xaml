<UserControl x:Class="SpreadsheetSampleExplorer.Samples.SpreadProperties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpreadsheetSampleExplorer.Samples"
             xmlns:sheets="http://schemas.devbrewlabs.com/2026/wpf/spreadsheet"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid Margin="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1" Padding="10" Margin="0,0,6,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Behavior Properties" FontWeight="Bold" FontSize="12" Margin="0,0,0,10" Foreground="#107C41"/>
                    <CheckBox Content="Allow Row Resize" IsChecked="{Binding ElementName=spread, Path=AllowRowResize, Mode=TwoWay}" Margin="0,4"/>
                    <CheckBox Content="Allow Column Resize" IsChecked="{Binding ElementName=spread, Path=AllowColumnResize, Mode=TwoWay}" Margin="0,4"/>
                    <CheckBox Content="Show Tab Strip" IsChecked="{Binding ElementName=spread, Path=ShowTabStrip, Mode=TwoWay}" Margin="0,4"/>
                    <CheckBox Content="Show Add New Sheet" IsChecked="{Binding ElementName=spread, Path=ShowAddNewSheet, Mode=TwoWay}" Margin="0,4"/>
                    <CheckBox Content="Selection Animation" IsChecked="{Binding ElementName=spread, Path=IsSelectionAnimationEnabled, Mode=TwoWay}" Margin="0,4"/>
                    <CheckBox Content="Formula Suggestions" IsChecked="{Binding ElementName=spread, Path=ShowFormulaSuggestions, Mode=TwoWay}" Margin="0,4"/>

                    <TextBlock Text="Scroll Mode:" Margin="0,15,0,4" FontWeight="SemiBold"/>
                    <ComboBox x:Name="_cmbScrollMode" SelectionChanged="OnScrollModeChanged">
                        <ComboBoxItem Content="Item"/>
                        <ComboBoxItem Content="Pixel"/>
                        <ComboBoxItem Content="Deferred"/>
                    </ComboBox>

                    <TextBlock Text="Appearance Properties" FontWeight="Bold" FontSize="12" Margin="0,20,0,10" Foreground="#107C41"/>
                    <TextBlock Text="Selection Background:" Margin="0,4,0,2" FontWeight="SemiBold"/>
                    <ComboBox x:Name="_cmbSelectionBackground" SelectionChanged="OnSelectionBackgroundChanged">
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="Light Blue"/>
                        <ComboBoxItem Content="Light Green"/>
                    </ComboBox>

                    <TextBlock Text="GridLine Brush:" Margin="0,10,0,2" FontWeight="SemiBold"/>
                    <ComboBox x:Name="_cmbGridLineBrush" SelectionChanged="OnGridLineBrushChanged">
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="Red"/>
                        <ComboBoxItem Content="Blue"/>
                    </ComboBox>

                    <TextBlock Text="Selection Border:" Margin="0,10,0,2" FontWeight="SemiBold"/>
                    <ComboBox x:Name="_cmbSelectionBorder" SelectionChanged="OnSelectionBorderChanged">
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="Dark Green"/>
                        <ComboBoxItem Content="Orange"/>
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" BorderThickness="1" BorderBrush="#E4E4E7" >
            <sheets:Spread x:Name="spread"/>
        </Border>
    </Grid>
</UserControl>
