<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DevBrewLabs.WPF.Spreadsheet"
    xmlns:components="clr-namespace:DevBrewLabs.WPF.Spreadsheet.Components">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DevBrewLabs.WPF.Spreadsheet;component/Themes/SheetTabControlStyle.xaml"></ResourceDictionary>
        <ResourceDictionary Source="DevBrewLabs.WPF.Spreadsheet;component/Themes/SuggestionListBoxStyle.xaml"></ResourceDictionary>
        <ResourceDictionary Source="/DevBrewLabs.WPF.Spreadsheet;component/Themes/ScrollBarStyle.xaml"/>
        <ResourceDictionary Source="DevBrewLabs.WPF.Spreadsheet;component/Themes/FilterDropdownStyle.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:Spread}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Spread}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid x:Name="root">
                            <components:SheetTabControl x:Name="_sheetTabControl"
                                                        Grid.Row="0" Grid.Column="0"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ScrollBarStyle" Value="{StaticResource ScrollBarStyle}" />
    </Style>
</ResourceDictionary>
