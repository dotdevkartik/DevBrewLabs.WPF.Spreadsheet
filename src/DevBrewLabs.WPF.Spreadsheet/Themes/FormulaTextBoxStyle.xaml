<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:components="clr-namespace:DevBrewLabs.WPF.Spreadsheet.Components">

    <Style x:Key="FormulaActionButtonStyle" TargetType="Button">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#E5E7EB"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#D1D5DB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormulaCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource FormulaActionButtonStyle}">
        <Setter Property="Foreground" Value="#EF4444"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#FEE2E2"/>
                            <Setter Property="Foreground" Value="#DC2626"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#FCA5A5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormulaCommitButtonStyle" TargetType="Button" BasedOn="{StaticResource FormulaActionButtonStyle}">
        <Setter Property="Foreground" Value="#16A34A"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#DCFCE7"/>
                            <Setter Property="Foreground" Value="#15803D"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#86EFAC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormulaEditorStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#D1D5DB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Segoe UI, Calibri, sans-serif"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Auto"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#9CA3AF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#107C41"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type components:FormulaTextBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:FormulaTextBox}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#F9FAFB"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="0"
                                Margin="0,0,4,0"
                                Padding="2"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PART_CancelButton" 
                                        Command="{TemplateBinding CancelCommand}" 
                                        Style="{StaticResource FormulaCancelButtonStyle}"
                                        Width="26"
                                        Height="24"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        ToolTip="Cancel (Esc)">✕</Button>
                                <Button x:Name="PART_CommitButton" 
                                        Command="{TemplateBinding CommitCommand}" 
                                        Style="{StaticResource FormulaCommitButtonStyle}" 
                                        Width="26"
                                        Height="24"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        ToolTip="Enter (Enter)">✓</Button>

                                <Rectangle Width="1" Fill="#E5E7EB" Margin="2,3"/>

                                <Button x:Name="PART_FunctionButton" 
                                        Style="{StaticResource FormulaActionButtonStyle}"
                                        Width="30"
                                        Height="24"
                                        FontSize="13"
                                        FontFamily="Georgia"
                                        FontStyle="Italic"
                                        FontWeight="Bold"
                                        Foreground="#374151"
                                        ToolTip="Insert Function">fx</Button>
                            </StackPanel>
                        </Border>

                        <TextBox x:Name="PART_Editor" 
                                 Grid.Column="1"
                                 MinWidth="100"
                                 Height="64"
                                 MinHeight="64"
                                 MaxHeight="64"
                                 TextWrapping="Wrap"
                                 Style="{StaticResource FormulaEditorStyle}"/>

                        <Button x:Name="PART_ExpandButton"
                                Grid.Column="2"
                                Style="{StaticResource FormulaActionButtonStyle}"
                                Width="24"
                                Height="24"
                                Margin="4,1,0,0"
                                VerticalAlignment="Top"
                                ToolTip="Collapse Formula Bar (Ctrl+Shift+U)">
                            <Path x:Name="PART_ExpandIcon"
                                  Data="M 2 7 L 6 3 L 10 7"
                                  Stroke="#4B5563"
                                  StrokeThickness="1.5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
